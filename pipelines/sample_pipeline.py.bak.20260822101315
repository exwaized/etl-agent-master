import logging
from pathlib import Path
import pandas as pd

log = logging.getLogger(__name__)

CSV_PATH = Path("data/sample.csv")


def build_steps(csv_path: Path = CSV_PATH) -> list[tuple[str, callable]]:
    state: dict = {}

    def load_csv() -> None:
        df = pd.read_csv(csv_path)
        state["df"] = df
        log.info("loaded %d rows, columns: %s", len(df), list(df.columns))

    def cast_types() -> None:
        df = state["df"]
        # KeyError if "amount" column is absent — CSV has "revenue" instead
        state["df"] = df.assign(amount=df["amount"].astype(float))
        log.info("cast 'amount' to float")

    def aggregate() -> pd.DataFrame:
        df = state["df"]
        summary = (
            df.groupby("category")["revenue"]
            .agg(total="sum", count="count")
            .reset_index()
        )
        state["summary"] = summary
        log.info("aggregation result:\n%s", summary.to_string(index=False))
        return summary

    return [
        ("load_csv",   load_csv),
        ("cast_types", cast_types),
        ("aggregate",  aggregate),
    ]
